            .Select(_ => new EtapaFirma(ModoEtapaFirma.Secuencial, [Ana]))
            .ToArray();

        Assert.Throws<CircuitoFirmaException>((Action)(() =>
            _ = new CircuitoFirma("DOC-001", "autor", sinEtapas)));
