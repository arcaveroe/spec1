        var etapa = new EtapaFirma(ModoEtapaFirma.Secuencial, firmantes);

        firmantes.Add(Marta);

        Assert.Equal(ModoEtapaFirma.Secuencial, etapa.Modo);
        Assert.Equal([Ana, Luis], etapa.Firmantes);
