            .ToArray();

        var circuito = new CircuitoFirma("DOC-001", "autor", etapas);

        Assert.Equal(5, circuito.Etapas.Count);
        Assert.Equal(5, new EtapaFirma(ModoEtapaFirma.Paralela, cincoFirmantes).Firmantes.Count);
    }
